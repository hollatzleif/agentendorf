# HTTPS mit automatischem Let's-Encrypt-Zertifikat. HTTP wird automatisch auf HTTPS umgeleitet.
{$DORF_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# Nur das Dorf selbst darf eigene Seiten einbetten (abgeschottete Lernzettel), sonst nie
		?X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Nur setzen, wenn das Dorf selbst keine strengere Regel schickt (z. B. für Rohdateien aus dem Vault).
		# frame-src (E205): einbetten darf die App nur sich selbst (abgeschottete Lernzettel) und VS Code im Codehaus.
		?Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' wss://{$DORF_DOMAIN} ipc: http://ipc.localhost; frame-src 'self' https://{$CODING_DOMAIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	reverse_proxy dorf:3000
}

# Codehaus (E191): VS Code im Browser auf EIGENER Adresse = eigener Ursprung. Das Sitzungs-Cookie des Dorfs gilt nur für
# {$DORF_DOMAIN} und wird hierher nie geschickt; VS Code und seine Erweiterungen können die Dorf-App nicht anfassen.
# Hinein kommt nur, wer im Dorf angemeldet ist: Dorf → Einmal-Karte → /_dorf/eintritt setzt ein eigenes Cookie,
# danach fragt Caddy vor JEDER Anfrage (auch WebSockets) das Dorf, ob es noch gilt. Zusätzlich verlangt VS Code sein
# Verbindungs-Token. Läuft der Coding-Container (noch) nicht, antwortet diese Adresse mit 401/502 – das Dorf merkt nichts.
{$CODING_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# E205: VS Code erscheint als eingebettetes Fenster in der Dorf-App (/codehaus/vscode). Einbetten dürfen es nur es selbst
	# und der Ursprung des Dorfs – sonst niemand (Schutz vor untergeschobenen Rahmen auf fremden Seiten).
	# VS Code schickt seine eigene Content-Security-Policy (ohne frame-ancestors); diese ZWEITE Kopfzeile kommt dazu –
	# Browser halten alle Policies gleichzeitig ein. X-Frame-Options kennt keine Liste erlaubter Ursprünge („SAMEORIGIN“
	# sperrte das Dorf aus) und wird entfernt; frame-ancestors ersetzt es in allen heutigen Browsern und WebViews.
	header {
		+Content-Security-Policy "frame-ancestors 'self' https://{$DORF_DOMAIN}"
		-X-Frame-Options
		defer
	}

	# Der EINZIGE Pfad dieser Adresse, der ans Dorf geht: Karte einlösen (die Dorf-API ist hier sonst nicht erreichbar)
	handle /_dorf/eintritt {
		rewrite * /api/coding/eintritt?{query}
		reverse_proxy dorf:3000
	}

	handle /_dorf/* {
		respond 404
	}

	handle {
		# Prüfung über den internen Port des Dorfs (von außen nicht erreichbar): 200 = weiter, sonst Antwort des Dorfs (401/302)
		forward_auth dorf:3001 {
			uri /intern/coding/zugang
		}
		reverse_proxy coding:3000
	}
}
