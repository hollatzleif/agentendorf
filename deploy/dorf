    rot "Nicht gespeichert (siehe Meldung oben)."; return 1
  fi
  [[ "$token" =~ ^[A-Za-z0-9]{16,64}$ ]] || { rot "Unerwartete Antwort – nicht gespeichert."; return 1; }
  sed -i '/^MOODLE_URL=/d;/^MOODLE_TOKEN=/d' "$ENV_DATEI"
  printf 'MOODLE_URL=%s\nMOODLE_TOKEN=%s\n' "$url" "$token" >> "$ENV_DATEI"
  compose up -d --force-recreate dorf
  gruen "Moodle verbunden. Der erste Abgleich startet in einer Minute (Uni → Übersicht → 'Jetzt abgleichen' geht sofort)."
}

# Moodle-Browser: JKU-Zugangsdaten nur in browser.env (liest nur der Browser-Container), dann Anmeldung prüfen.
cmd_moodle_browser_zugang() {
  local benutzer passwort hosts neu uid datei="$BASIS/browser.env"
  [ -f "$AKTUELL/BROWSER_VERSION" ] || { rot "Diese Version hat noch keinen Moodle-Browser – nach dem nächsten Deploy erneut versuchen."; return 1; }
  geheimnisse_sicherstellen
  info "Dein JKU-Login (wie bei moodle.jku.at). Wird nur auf diesem Server in $datei gespeichert."
  read -r -p "Benutzername (z. B. k12345678): " benutzer
  benutzer=$(printf '%s' "$benutzer" | tr -d '\r\n ')
  [[ "$benutzer" =~ ^[A-Za-z0-9._@-]{2,80}$ ]] || { rot "Ungültiger Benutzername."; return 1; }
  IFS= read -r -s -p "Passwort (unsichtbar): " passwort; echo
  [ -n "$passwort" ] || { rot "Abgebrochen."; return 1; }
  case "$passwort" in *$'\n'*|*$'\r'*) rot "Passwort mit Zeilenumbruch geht nicht."; return 1 ;; esac
  hosts=$(sed -n 's/^BROWSER_HOSTS=//p' "$datei" | tail -1)
  read -r -p "Erlaubte Domains [${hosts:-jku.at}] (Enter = so lassen – fast immer richtig): " neu
  neu=$(printf '%s' "${neu:-}" | tr -d '\r ')
  [ -z "$neu" ] || hosts=$neu
  [[ "${hosts:-jku.at}" =~ ^[a-z0-9.,-]+$ ]] || { rot "Ungültige Domains (nur z. B. jku.at,login.example.org)."; return 1; }
  # Moodle selbst muss immer erlaubt bleiben – sonst sperrt sich der Browser aus (passiert, wenn man nur einen Login-Host einträgt)
  case ",${hosts:-jku.at}," in
    *,jku.at,*|*,moodle.jku.at,*) ;;
    *) info "jku.at fehlte in der Liste – ergänzt (sonst wäre moodle.jku.at selbst gesperrt)."; hosts="jku.at,${hosts}" ;;
  esac
  # Zeilen ersetzen, ohne das Passwort durch sed zu schicken
  grep -vE '^(MOODLE_BENUTZER|MOODLE_PASSWORT|BROWSER_HOSTS)=' "$datei" > "$datei.neu" || true
  { printf 'MOODLE_BENUTZER=%s\n' "$benutzer"; printf 'MOODLE_PASSWORT=%s\n' "$passwort"; printf 'BROWSER_HOSTS=%s\n' "${hosts:-jku.at}"; } >> "$datei.neu"
  chmod 600 "$datei.neu" && mv "$datei.neu" "$datei"
  uid=$(grep -E '^DORF_UID=' "$ENV_DATEI" | cut -d= -f2 || true)
  chown "${uid:-1000}:${uid:-1000}" "$datei" 2>/dev/null || true
  compose up -d --force-recreate browser dorf
  info "Prüfe die Anmeldung bei Moodle (bis zu einer Minute) …"
  sleep 5
  if compose exec -T browser node runner.js pruefen; then
    gruen "Moodle-Browser angemeldet. In der App: Uni → Aktionen → Moodle durchsehen."
  else
    rot "Anmeldung hat nicht geklappt (Meldung oben). Daten prüfen und 'dorf moodle-browser-zugang' erneut ausführen."
    return 1
  fi
}

# Codehaus (E191): VS Code im Browser + Coding-Agenten. Fragt GitHub-Token und Git-Namen ab, übernimmt das Abo-Token der
# Werkstatt (oder ein eigenes), schreibt /srv/dorf/coding.env (600, nur für den Coding-Container) und startet den Dienst.
# In den Coding-Container kommt NICHTS aus /srv/dorf/.env. Erneut ausführen = Angaben ändern (Enter behält Bisheriges).
cmd_coding_einrichten() {
  local datei="$BASIS/coding.env" domain code abo neu gh gh_alt antwort login name mail name_alt mail_alt g uid code_http
  geheimnisse_sicherstellen
  domain=$(grep -E '^DORF_DOMAIN=' "$ENV_DATEI" | cut -d= -f2)
  code=$(grep -E '^CODING_DOMAIN=' "$ENV_DATEI" | cut -d= -f2 || true)
  code=${code:-code.$domain}
  info "Das Codehaus bekommt: dein Claude-Abo (für Claude Code), ein GitHub-Token und deinen Git-Namen – sonst nichts."
  info "Agenten dort können Befehle ausführen, ins Internet, den Vault lesen und schreiben und auf GitHub pushen und mergen."

  # 1. Claude-Abo: das Token der Werkstatt übernehmen oder ein eigenes eintragen
  abo=$(grep -E '^CLAUDE_CODE_OAUTH_TOKEN=' "$datei" | cut -d= -f2 || true)
  [ -n "$abo" ] || abo=$(grep -E '^CLAUDE_CODE_OAUTH_TOKEN=' "$BASIS/werkstatt.env" 2>/dev/null | cut -d= -f2 || true)
  if [ -n "$abo" ]; then
    read -r -s -p "Claude-Abo: Enter = vorhandenes Token (Werkstatt) nehmen, oder ein eigenes einfügen (unsichtbar): " neu; echo
  else
    info "Noch kein Abo-Token da. Erzeuge eines mit 'dorf claude-anmelden' (oder am eigenen Rechner: claude setup-token) und füge es ein."
    read -r -s -p "Abo-Token (sk-ant-oat…, unsichtbar, leer = abbrechen): " neu; echo
  fi
  neu=$(printf '%s' "$neu" | tr -d '\r\n ')
  if [ -n "$neu" ]; then
    case "$neu" in sk-ant-oat*) ;; *) rot "Das sieht nicht wie ein Abo-Token aus (es beginnt mit sk-ant-oat…)."; return 1 ;; esac
    [[ "$neu" =~ ^[A-Za-z0-9_-]{80,}$ ]] || { rot "Token zu kurz oder mit ungültigen Zeichen – vermutlich beim Kopieren abgeschnitten."; return 1; }
    abo=$neu
  fi
  [ -n "$abo" ] || { rot "Ohne Abo-Token kein Codehaus. Abgebrochen."; return 1; }

  # 2. GitHub: Token mit Schreibrechten auf die gewünschten Repositories
  gh_alt=$(grep -E '^GH_TOKEN=' "$datei" | cut -d= -f2 || true)
  info "GitHub-Token: github.com → Settings → Developer settings → Fine-grained tokens. Nur die Repositories wählen, an denen"
  info "Agenten arbeiten sollen; Rechte: Contents, Pull requests (je Read and write), Metadata (Read); für CI-Dateien auch Workflows."
  read -r -s -p "GitHub-Token (github_pat_… oder ghp_…, unsichtbar${gh_alt:+, Enter = bisheriges behalten}): " gh; echo
  gh=$(printf '%s' "$gh" | tr -d '\r\n ')
  gh=${gh:-$gh_alt}
  login=""; name=""; mail=""
  if [ -n "$gh" ]; then
    [[ "$gh" =~ ^(ghp_|github_pat_|gho_)[A-Za-z0-9_]{20,255}$ ]] || { rot "Das sieht nicht wie ein GitHub-Token aus (github_pat_… oder ghp_…)."; return 1; }
    antwort=$(curl -sS -m 20 -w '\n%{http_code}' -H "Authorization: Bearer $gh" -H 'Accept: application/vnd.github+json' https://api.github.com/user || printf '\n000')
    code_http=$(tail -1 <<<"$antwort")
    case "$code_http" in
      200)
        login=$(sed '$d' <<<"$antwort" | jq -r '.login // empty')
        name=$(sed '$d' <<<"$antwort" | jq -r '.name // empty')
        mail=$(sed '$d' <<<"$antwort" | jq -r 'if .id and .login then "\(.id)+\(.login)@users.noreply.github.com" else empty end')
        gruen "GitHub kennt das Token: angemeldet als $login." ;;
      401|403) rot "GitHub lehnt das Token ab (HTTP $code_http)."; return 1 ;;
      *) info "GitHub antwortet mit HTTP $code_http – ich trage das Token trotzdem ein (prüfen im VS-Code-Terminal: gh auth status)." ;;
    esac
  else
    info "Kein GitHub-Token: Agenten können klonen (öffentliche Repositories), aber nicht pushen. Später: dorf coding-einrichten"
  fi

  # 3. Git-Name und E-Mail (stehen in jedem Commit)
  name_alt=$(grep -E '^GIT_NAME=' "$datei" | cut -d= -f2- || true)
  mail_alt=$(grep -E '^GIT_EMAIL=' "$datei" | cut -d= -f2- || true)
  name=${name_alt:-${name:-$login}}
  mail=${mail_alt:-$mail}
  read -r -p "Name für Commits [${name:-–}]: " antwort
  name=${antwort:-$name}
  read -r -p "E-Mail für Commits [${mail:-–}]: " antwort
  mail=$(printf '%s' "${antwort:-$mail}" | tr -d '\r\n ')
  name=$(printf '%s' "$name" | tr -d '\r\n')
  # nichts, was eine env-Datei anders liest als gemeint (Anführungszeichen, $, #, Rückstrich)
  case "$name" in *[\"\'\\\$\#\`=]*) rot "Name: ohne Anführungszeichen, \$, #, = und Rückstrich."; return 1 ;; esac
  [ -n "$name" ] && [ "${#name}" -le 80 ] || { rot "Name: 1–80 Zeichen."; return 1; }
  [[ "$mail" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || { rot "Das sieht nicht wie eine E-Mail-Adresse aus."; return 1; }

  # 4. Geheimnisse Dorf ↔ Codehaus (Runner) und das Verbindungs-Token von VS Code – nur erzeugen, wenn sie fehlen
  if ! grep -qE '^CODING_GEHEIMNIS=.{32,}' "$ENV_DATEI"; then
    g=$(zufall 40); sed -i '/^CODING_GEHEIMNIS=/d' "$ENV_DATEI"; echo "CODING_GEHEIMNIS=$g" >> "$ENV_DATEI"
  fi
  if ! grep -qE '^CODING_VSCODE_TOKEN=.{32,}' "$ENV_DATEI"; then
    g=$(zufall 48); sed -i '/^CODING_VSCODE_TOKEN=/d' "$ENV_DATEI"; echo "CODING_VSCODE_TOKEN=$g" >> "$ENV_DATEI"
  fi
  sed -i '/^CODING_AN=/d' "$ENV_DATEI"; echo "CODING_AN=ja" >> "$ENV_DATEI"

  # 5. coding.env neu schreiben (nur diese sechs Zeilen), Rechte 600, gehört dem Container-Benutzer
  {
    printf '# Nur für den Coding-Container (Codehaus). Ändern mit: dorf coding-einrichten\n'
    printf 'CODING_GEHEIMNIS=%s\n' "$(grep -E '^CODING_GEHEIMNIS=' "$ENV_DATEI" | cut -d= -f2)"
    printf 'VSCODE_TOKEN=%s\n' "$(grep -E '^CODING_VSCODE_TOKEN=' "$ENV_DATEI" | cut -d= -f2)"
    printf 'CLAUDE_CODE_OAUTH_TOKEN=%s\n' "$abo"
    [ -z "$gh" ] || printf 'GH_TOKEN=%s\n' "$gh"
    printf 'GIT_NAME=%s\n' "$name"
    printf 'GIT_EMAIL=%s\n' "$mail"
  } > "$datei.neu"
  chmod 600 "$datei.neu" && mv "$datei.neu" "$datei"
  uid=$(grep -E '^DORF_UID=' "$ENV_DATEI" | cut -d= -f2 || true)
  mkdir -p "$BASIS/coding" "$BASIS/claude-coding"
  chown "${uid:-1000}:${uid:-1000}" "$datei" "$BASIS/coding" "$BASIS/claude-coding" 2>/dev/null || true

  # 6. Adresse von VS Code: muss auf diesen Server zeigen (bei DuckDNS tun das alle Unteradressen von selbst)
  if command -v getent >/dev/null 2>&1 && ! getent hosts "$code" >/dev/null 2>&1; then
    rot "Achtung: $code lässt sich nicht auflösen. Leg dafür einen DNS-Eintrag auf diesen Server an – oder trag eine"
    rot "andere Adresse als CODING_DOMAIN=… in $ENV_DATEI ein und führe 'dorf coding-einrichten' noch einmal aus."
  fi

  # E195: Das Image (rund 0,5 GB Übertragung) kommt erst, wenn das Codehaus hier eingeschaltet ist – mit dem nächsten Deploy.
  if [ ! -f "$AKTUELL/CODING_VERSION" ]; then
    compose up -d --force-recreate dorf
    gruen "Eingerichtet. Das Codehaus-Image ist noch nicht auf diesem Server – es kommt mit dem nächsten Deploy:"
    info 'GitHub → Actions → „Prüfen und ausliefern“ → Run workflow (oder der nächste Push). Danach startet das Codehaus von selbst.'
    return 0
  fi
  info "Starte das Codehaus (das Dorf startet dabei kurz neu) …"
  compose up -d --force-recreate coding dorf
  if gesund_warten; then
    gruen "Codehaus läuft. In der App: Codehaus → VS Code öffnen (Adresse: https://$code – nur über das Dorf, mit deiner Anmeldung)."
    info "Beim ersten Aufruf holt Caddy das Zertifikat für $code; das dauert ein paar Sekunden."
  else
    return 1
  fi
}

# Codehaus anhalten: Container weg, Schalter aus. Projekte (/srv/dorf/coding), Einstellungen und coding.env bleiben.
cmd_coding_aus() {
  if coding_an; then compose rm -sf coding || true; fi
  sed -i '/^CODING_AN=/d' "$ENV_DATEI"
  compose up -d --remove-orphans
  gruen "Codehaus angehalten. Wieder einschalten: dorf coding-einrichten"
}

# Google anmelden (OAuth): Gmail nur Lesen + Entwürfe, dazu der Kalender (E75). Client-ID/-Schlüssel aus Leifs eigenem Google-Cloud-Projekt.
cmd_gmail_anmelden() {
  local id secret aus adresse verifier state rueck token
  info "Für den Kalender: Cloud Console → APIs & Dienste → Bibliothek → Google Calendar API → Aktivieren (einmalig)."
  # schon einmal angemeldet → gespeicherte Client-ID/-Schlüssel nehmen (Leif muss sie nicht neu heraussuchen)
  id=$(grep -E '^GMAIL_CLIENT_ID=' "$ENV_DATEI" | cut -d= -f2- || true)
  secret=$(grep -E '^GMAIL_CLIENT_SECRET=' "$ENV_DATEI" | cut -d= -f2- || true)
  if [ -n "$id" ] && [ -n "$secret" ]; then
    info "Nehme die gespeicherte Client-ID ($id) und den gespeicherten Clientschlüssel."
  else
    info "Google Cloud Console → Clients → deine Desktop-App: Client-ID und Clientschlüssel bereithalten."
    read -r -p "Client-ID: " id
    read -r -s -p "Clientschlüssel (unsichtbar): " secret; echo
  fi
  id=$(printf '%s' "$id" | tr -d '\r\n ')
  [[ "$id" =~ ^[0-9]+-[a-z0-9]+\.apps\.googleusercontent\.com$ ]] || { rot "Das sieht nicht wie eine Client-ID aus (…apps.googleusercontent.com)."; return 1; }
  secret=$(printf '%s' "$secret" | tr -d '\r\n ')
  [[ "$secret" =~ ^[A-Za-z0-9_-]{10,100}$ ]] || { rot "Das sieht nicht wie ein Clientschlüssel aus."; return 1; }
  aus=$(compose exec -T dorf node dist/cli.js gmail-anmelden-start "$id") || { rot "Konnte die Anmeldung nicht vorbereiten."; return 1; }
  adresse=$(sed -n 1p <<<"$aus"); verifier=$(sed -n 2p <<<"$aus"); state=$(sed -n 3p <<<"$aus")
  info "1. Öffne diese Adresse im Browser und melde dich mit deinem Gmail-Konto an:"
  echo; echo "   $adresse"; echo
  info "2. Warnt Google, die App sei nicht überprüft: Erweitert → Weiter zu Agentendorf. ALLE Haken setzen (Mail lesen, Entwürfe, Kalender)."
  info "3. Danach lädt eine Seite, die nicht erreichbar ist (127.0.0.1) – das ist richtig so."
  info "   Kopiere die KOMPLETTE Adresse aus der Adresszeile (beginnt mit http://127.0.0.1:8765/)."
  read -r -s -p "4. Adresse hier einfügen (unsichtbar): " rueck; echo
  rueck=$(printf '%s' "$rueck" | tr -d '\r\n ')
  [ -n "$rueck" ] || { rot "Abgebrochen."; return 1; }
  if ! token=$(jq -n --arg c "$id" --arg s "$secret" --arg v "$verifier" --arg st "$state" --arg a "$rueck" \
      '{clientId:$c, clientSecret:$s, verifier:$v, state:$st, adresse:$a}' | compose exec -T dorf node dist/cli.js gmail-anmelden-tauschen); then
    rot "Nicht gespeichert (siehe Meldung oben)."; return 1
  fi
  [[ "$token" =~ ^[A-Za-z0-9_./-]{20,512}$ ]] || { rot "Unerwartete Antwort – nicht gespeichert."; return 1; }
  sed -i '/^GMAIL_CLIENT_ID=/d;/^GMAIL_CLIENT_SECRET=/d;/^GMAIL_REFRESH_TOKEN=/d' "$ENV_DATEI"
  printf 'GMAIL_CLIENT_ID=%s\nGMAIL_CLIENT_SECRET=%s\nGMAIL_REFRESH_TOKEN=%s\n' "$id" "$secret" "$token" >> "$ENV_DATEI"
  compose up -d --force-recreate dorf
  gruen "Google verbunden. Post: Eingang → Jetzt abholen (sonst alle 10 Minuten). Kalender: Marktplatz → Kalender."
}

# Google-Kalender (geheime iCal-Adressen): „Moodle-Fristen (automatisch)“ aus Leifs Skript, „JKU Pflicht“
# und der Hauptkalender (nur für die Morgenzeitung, wird nicht gespeichert).
cmd_google_kalender() {
  local art url var geaendert=""
  info "Google Kalender (Browser) → Zahnrad → Einstellungen → links den Kalender wählen → Kalender integrieren"
  info "→ Geheime Adresse im iCal-Format kopieren. Leer lassen + Enter = diesen Kalender nicht ändern."
  for art in fristen pflicht termine; do
    case "$art" in
      fristen) var=GOOGLE_FRISTEN_ICS; read -r -s -p "Adresse von Moodle-Fristen (automatisch) (unsichtbar): " url; echo ;;
      pflicht) var=GOOGLE_PFLICHT_ICS; read -r -s -p "Adresse von JKU Pflicht (unsichtbar): " url; echo ;;
      termine) var=GOOGLE_TERMINE_ICS; read -r -s -p "Adresse deines Hauptkalenders, fuer die Morgenzeitung (unsichtbar): " url; echo ;;
    esac
    url=$(printf '%s' "$url" | tr -d '\r\n ')
    if [ -z "$url" ]; then info "übersprungen"; continue; fi
    [[ "$url" =~ ^https://calendar\.google\.com/calendar/ical/[A-Za-z0-9%._@+-]+/private-[0-9a-f]{16,64}/basic\.ics$ ]] \
      || { rot "Das ist keine geheime Google-Kalender-Adresse (…/calendar/ical/…/private-…/basic.ics)."; return 1; }
    if ! printf '%s' "$url" | compose exec -T dorf node dist/cli.js google-kalender-pruefen "$art"; then
      rot "Nicht gespeichert (siehe Meldung oben)."; return 1
    fi
    sed -i "/^$var=/d" "$ENV_DATEI"
    printf '%s=%s\n' "$var" "$url" >> "$ENV_DATEI"
    geaendert=ja
  done
  [ -n "$geaendert" ] || { info "Nichts geändert."; return 0; }
  # Fristen kommen jetzt über dein Skript aus Google – der direkte Moodle-Kalender würde sie doppelt liefern
  if grep -q '^GOOGLE_FRISTEN_ICS=' "$ENV_DATEI" && grep -q '^MOODLE_KALENDER_URL=' "$ENV_DATEI"; then
    sed -i '/^MOODLE_KALENDER_URL=/d' "$ENV_DATEI"
    info "Direkter Moodle-Kalender entfernt (dein Skript trägt die Fristen schon in Google ein)."
  fi
  compose up -d --force-recreate dorf
  gruen "Google-Kalender eingetragen. In der App: Uni → Studium → Jetzt abgleichen (sonst automatisch alle 3 Stunden)."
}

# Fristen über den Kalender-Export von Moodle (an der JKU der Weg, weil der App-Zugang gesperrt ist).
cmd_moodle_kalender() {
  local url
  info "In Moodle: Kalender → Exportieren → Alle Termine + längster Zeitraum → Kalender-URL abrufen → Adresse kopieren."
  read -r -s -p "Kalender-Adresse hier einfügen (Eingabe unsichtbar, leer = abbrechen): " url; echo
  url=$(printf '%s' "$url" | tr -d '\r\n ')
  [ -n "$url" ] || { rot "Abgebrochen."; return 1; }
  [[ "$url" =~ ^https://[A-Za-z0-9.-]+(/[A-Za-z0-9._-]+)*/calendar/export_execute\.php\?[A-Za-z0-9_=\&%.+-]+$ ]] \
    || { rot "Das sieht nicht wie eine Moodle-Kalender-Adresse aus (…/calendar/export_execute.php?…)."; return 1; }
  [[ "$url" == *authtoken=* ]] || { rot "In der Adresse fehlt authtoken= – bitte die vollständige Adresse kopieren."; return 1; }
  if ! printf '%s' "$url" | compose exec -T dorf node dist/cli.js moodle-kalender-pruefen; then
    rot "Nicht gespeichert (siehe Meldung oben)."; return 1
  fi
  sed -i '/^MOODLE_KALENDER_URL=/d' "$ENV_DATEI"
  printf 'MOODLE_KALENDER_URL=%s\n' "$url" >> "$ENV_DATEI"
  compose up -d --force-recreate dorf
  gruen "Kalender verbunden. In der App: Uni → Studium → Jetzt abgleichen (sonst automatisch alle 3 Stunden)."
}

cmd_syncthing_id() { compose exec -T syncthing syncthing device-id 2>/dev/null || compose exec -T syncthing syncthing --device-id; }

cmd_syncthing_geraet() {
  local id=${1:-} name=${2:-}
  [ -n "$id" ] && [ -n "$name" ] || { echo "Aufruf: dorf syncthing-geraet <GERAETE-ID> <Name>"; return 1; }
  local st=(compose exec -T syncthing syncthing cli)
  "${st[@]}" config folders list 2>/dev/null | grep -qx vault || "${st[@]}" config folders add --id vault --label Agentendorf --path /var/syncthing/vault
  "${st[@]}" config devices add --device-id "$id" --name "$name"
  "${st[@]}" config folders vault devices add --device-id "$id"
  gruen "Gerät $name hinzugefügt. Auf dem Gerät: Server-ID ($(cmd_syncthing_id)) hinzufügen und den Ordner 'Agentendorf' annehmen."
}

