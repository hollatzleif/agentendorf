#!/usr/bin/env bash
# Agentendorf – Verwaltung auf dem Server. Aufruf: dorf <befehl>   (dorf hilfe zeigt alles)
set -euo pipefail

BASIS=${DORF_BASIS:-/srv/dorf}
# Alles läuft als root (Docker, Backup-Passwort). Der Benutzer hat sudo ohne Passwort.
if [ "$(id -u)" -ne 0 ] && [ -z "${DORF_TEST:-}" ]; then
  exec sudo -n SSH_ORIGINAL_COMMAND="${SSH_ORIGINAL_COMMAND:-}" DORF_BASIS="$BASIS" "$(readlink -f "$0")" "$@"
fi
APP="$BASIS/app"
AKTUELL="$APP/current"
ENV_DATEI="$BASIS/.env"
export RESTIC_REPOSITORY="$BASIS/backup/restic"
export RESTIC_PASSWORD_FILE="$BASIS/backup/restic-passwort"
BEHALTEN_TAGE=7d

# Zufällige Zeichenkette (A-Za-z0-9). Endliche Quelle statt „tr </dev/urandom | head“ – das bricht mit pipefail still ab.
zufall() { head -c 96 /dev/urandom | base64 -w0 | tr -dc 'A-Za-z0-9' | cut -c1-"$1"; }
rot() { printf '\033[31m%s\033[0m\n' "$*" >&2; }
gruen() { printf '\033[32m%s\033[0m\n' "$*"; }
info() { printf '» %s\n' "$*"; }

compose() {
  local version rv bv profile=""
  version=$(cat "$AKTUELL/VERSION" 2>/dev/null || echo latest)
  rv=$(cat "$AKTUELL/RECHENRAUM_VERSION" 2>/dev/null || echo fehlt)
  # Moodle-Browser nur, wenn diese Version ein Browser-Image mitbringt (Compose-Profil „browser“)
  bv=$(cat "$AKTUELL/BROWSER_VERSION" 2>/dev/null || echo fehlt)
  [ "$bv" = fehlt ] || profile=browser
  DORF_VERSION="$version" RECHENRAUM_VERSION="$rv" BROWSER_VERSION="$bv" COMPOSE_PROFILES="$profile" \
    docker compose --project-name dorf --env-file "$ENV_DATEI" -f "$AKTUELL/deploy/compose.yml" "$@"
}

# Gesundheitsprüfung eines Dienstes von innen (Rechenraum hat Python statt Node)
gesund_pruefen() { # dienst port pfad
  if [ "$1" = rechenraum ]; then
    compose exec -T "$1" python3 -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:$2$3',timeout=3).status==200 else 1)" 2>/dev/null
  else
    compose exec -T "$1" node -e "fetch('http://127.0.0.1:$2$3').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" 2>/dev/null
  fi
}

gesund_warten() {
  local eintrag dienst port pfad ok
  for eintrag in dorf:3000:/api/gesundheit werkstatt:4000:/gesundheit rechenraum:4100:/gesundheit browser:4200:/gesundheit; do
    IFS=: read -r dienst port pfad <<< "$eintrag"
    # ältere Versionen (vor Etappe 3) haben keinen Rechenraum, Versionen ohne Browser-Image keinen Browser
    [ "$dienst" != rechenraum ] || [ -f "$AKTUELL/RECHENRAUM_VERSION" ] || continue
    [ "$dienst" != browser ] || [ -f "$AKTUELL/BROWSER_VERSION" ] || continue
    ok=nein
    for _ in $(seq 1 60); do
      if gesund_pruefen "$dienst" "$port" "$pfad"; then
        ok=ja
        break
      fi
      sleep 2
    done
    if [ "$ok" != ja ] && [ "$dienst" = browser ]; then
      # Der Moodle-Browser ist eine Zusatzfunktion: Warnung, aber kein Rollback des ganzen Dorfs
      rot "Warnung: Moodle-Browser meldet sich nicht gesund – das Dorf läuft trotzdem weiter."
      compose logs --tail 30 browser || true
      continue
    fi
    [ "$ok" = ja ] || { rot "Dienst $dienst meldet sich nicht gesund."; compose logs --tail 30 "$dienst"; return 1; }
  done
}

# Werkstatt-Geheimnis (Dorf ↔ Werkstatt) und werkstatt.env anlegen, falls sie fehlen. Bestehendes bleibt.
geheimnisse_sicherstellen() {
  local g uid
  uid=$(grep -E '^DORF_UID=' "$ENV_DATEI" | cut -d= -f2 || true)
  if ! grep -qE '^WERKSTATT_GEHEIMNIS=.{32,}' "$ENV_DATEI"; then
    g=$(zufall 40)
    sed -i '/^WERKSTATT_GEHEIMNIS=/d' "$ENV_DATEI"
    echo "WERKSTATT_GEHEIMNIS=$g" >> "$ENV_DATEI"
  fi
  g=$(grep -E '^WERKSTATT_GEHEIMNIS=' "$ENV_DATEI" | cut -d= -f2)
  if [ ! -f "$BASIS/werkstatt.env" ]; then
    printf '# Nur für den Werkstatt-Container. Abo-Token mit: dorf claude-anmelden\nWERKSTATT_GEHEIMNIS=%s\nCLAUDE_CODE_OAUTH_TOKEN=\n' "$g" > "$BASIS/werkstatt.env"
  else
    sed -i "s/^WERKSTATT_GEHEIMNIS=.*/WERKSTATT_GEHEIMNIS=$g/" "$BASIS/werkstatt.env"
  fi
  chmod 600 "$BASIS/werkstatt.env"
  # Rechenraum: eigenes Geheimnis, eigene Datei (bekommt sonst NICHTS aus .env)
  if ! grep -qE '^RECHENRAUM_GEHEIMNIS=.{32,}' "$ENV_DATEI"; then
    g=$(zufall 40)
    sed -i '/^RECHENRAUM_GEHEIMNIS=/d' "$ENV_DATEI"
    echo "RECHENRAUM_GEHEIMNIS=$g" >> "$ENV_DATEI"
  fi
  printf '# Nur für den Rechenraum-Container (wird von dorf deploy erzeugt)\nRECHENRAUM_GEHEIMNIS=%s\n' "$(grep -E '^RECHENRAUM_GEHEIMNIS=' "$ENV_DATEI" | cut -d= -f2)" > "$BASIS/rechenraum.env"
  chmod 600 "$BASIS/rechenraum.env"
  [ -n "$uid" ] && chown "$uid:$uid" "$BASIS/rechenraum.env" 2>/dev/null || true
  mkdir -p "$BASIS/claude"
  [ -n "$uid" ] && chown "$uid:$uid" "$BASIS/claude" "$BASIS/werkstatt.env" 2>/dev/null || true
  # Moodle-Browser: eigenes Geheimnis; browser.env (Leifs JKU-Zugang) bekommt NUR der Browser-Container
  if ! grep -qE '^BROWSER_GEHEIMNIS=.{32,}' "$ENV_DATEI"; then
    g=$(zufall 40)
    sed -i '/^BROWSER_GEHEIMNIS=/d' "$ENV_DATEI"
    echo "BROWSER_GEHEIMNIS=$g" >> "$ENV_DATEI"
  fi
  g=$(grep -E '^BROWSER_GEHEIMNIS=' "$ENV_DATEI" | cut -d= -f2)
  if [ ! -f "$BASIS/browser.env" ]; then
    printf '# Nur für den Moodle-Browser-Container. Zugang setzen mit: dorf moodle-browser-zugang\nBROWSER_GEHEIMNIS=%s\nMOODLE_WEB_URL=https://moodle.jku.at\nBROWSER_HOSTS=jku.at\nMOODLE_BENUTZER=\nMOODLE_PASSWORT=\n' "$g" > "$BASIS/browser.env"
  else
    sed -i "s/^BROWSER_GEHEIMNIS=.*/BROWSER_GEHEIMNIS=$g/" "$BASIS/browser.env"
  fi
  chmod 600 "$BASIS/browser.env"
  # als Datei eingebunden → muss dem Container-Benutzer gehören (Standard 1000)
  chown "${uid:-1000}:${uid:-1000}" "$BASIS/browser.env" 2>/dev/null || true
}

cmd_deploy() {
  [ -n "${DORF_TEST:-}" ] || geheimnisse_sicherstellen
  info "Starte Version $(cat "$AKTUELL/VERSION") …"
  compose up -d --remove-orphans
  if gesund_warten; then gruen "Dorf läuft: https://$(grep -E '^DORF_DOMAIN=' "$ENV_DATEI" | cut -d= -f2)"; else return 1; fi
}

# Wird von GitHub Actions per SSH aufgerufen (erzwungener Befehl). Erwartet ein tar.gz-Bündel auf stdin:
#   VERSION, deploy/…, image.tar.gz, RECHENRAUM_VERSION und – nur wenn der Server es noch nicht hat – rechenraum.tar.gz
cmd_empfangen() {
  local tmp version ziel vorher rv bv
  tmp=$(mktemp -d)
  # Aufräumen beim Verlassen dieser Funktion – die Falle entfernt sich selbst, sonst feuert sie später erneut.
  trap 'rm -rf "${tmp:-}"; trap - RETURN' RETURN
  tar -xzf - -C "$tmp"
  version=$(tr -cd 'a-zA-Z0-9._-' < "$tmp/VERSION")
  [ -n "$version" ] || { rot "Bündel ohne VERSION"; return 1; }
  rv=""
  bv=""
  if [ -f "$tmp/BROWSER_VERSION" ]; then
    bv=$(tr -cd 'a-f0-9' < "$tmp/BROWSER_VERSION")
    [[ "$bv" =~ ^[a-f0-9]{16}$ ]] || { rot "Ungültige BROWSER_VERSION"; return 1; }
    if [ -f "$tmp/browser.tar.gz" ]; then
      info "Lade Browser-Image $bv …"
      gunzip -c "$tmp/browser.tar.gz" | docker load
    fi
    docker image inspect "agentendorf-browser:$bv" >/dev/null 2>&1 || { rot "Browser-Image $bv fehlt auf dem Server und war nicht im Bündel."; return 1; }
  fi
  if [ -f "$tmp/RECHENRAUM_VERSION" ]; then
    rv=$(tr -cd 'a-f0-9' < "$tmp/RECHENRAUM_VERSION")
    [[ "$rv" =~ ^[a-f0-9]{16}$ ]] || { rot "Ungültige RECHENRAUM_VERSION"; return 1; }
    if [ -f "$tmp/rechenraum.tar.gz" ]; then
      info "Lade Rechenraum-Image $rv …"
      gunzip -c "$tmp/rechenraum.tar.gz" | docker load
    fi
    docker image inspect "agentendorf-rechenraum:$rv" >/dev/null 2>&1 || { rot "Rechenraum-Image $rv fehlt auf dem Server und war nicht im Bündel."; return 1; }
  fi
  info "Empfange Version $version"
  ziel="$APP/releases/$version"
  rm -rf "$ziel"; mkdir -p "$ziel"
  cp -r "$tmp/deploy" "$ziel/deploy"
  echo "$version" > "$ziel/VERSION"
  [ -z "$rv" ] || echo "$rv" > "$ziel/RECHENRAUM_VERSION"
  [ -z "$bv" ] || echo "$bv" > "$ziel/BROWSER_VERSION"
  info "Lade Image …"
  gunzip -c "$tmp/image.tar.gz" | docker load
  vorher=$(readlink -f "$AKTUELL" 2>/dev/null || true)
  ln -sfn "$ziel" "$AKTUELL.neu" && mv -T "$AKTUELL.neu" "$AKTUELL"
  ln -sfn "$AKTUELL/deploy/dorf" /usr/local/bin/dorf 2>/dev/null || true
  if cmd_deploy; then
    # nur die letzten 3 Versionen behalten
    ls -1dt "$APP"/releases/* | tail -n +4 | while read -r alt; do
      docker image rm "agentendorf:$(basename "$alt")" "agentendorf-werkstatt:$(basename "$alt")" >/dev/null 2>&1 || true
      rm -rf "$alt"
    done
    rechenraum_aufraeumen
    browser_aufraeumen
    gruen "Deploy von $version erfolgreich."
  else
    if [ -n "$vorher" ] && [ "$vorher" != "$ziel" ]; then
      rot "Deploy fehlgeschlagen – zurück auf $(basename "$vorher")"
      ln -sfn "$vorher" "$AKTUELL.neu" && mv -T "$AKTUELL.neu" "$AKTUELL"
      cmd_deploy || true
    fi
    return 1
  fi
}

# Rechenraum-Images, die keine der behaltenen Versionen mehr braucht, entfernen (sie sind groß).
rechenraum_aufraeumen() {
  local behalten tag
  behalten=$(cat "$APP"/releases/*/RECHENRAUM_VERSION 2>/dev/null || true)
  docker images agentendorf-rechenraum --format '{{.Tag}}' 2>/dev/null | while read -r tag; do
    [ -n "$tag" ] || continue
    grep -qx "$tag" <<< "$behalten" || docker image rm "agentendorf-rechenraum:$tag" >/dev/null 2>&1 || true
  done
}

# Browser-Images, die keine behaltene Version mehr braucht, entfernen.
browser_aufraeumen() {
  local behalten tag
  behalten=$(cat "$APP"/releases/*/BROWSER_VERSION 2>/dev/null || true)
  docker images agentendorf-browser --format '{{.Tag}}' 2>/dev/null | while read -r tag; do
    [ -n "$tag" ] || continue
    grep -qx "$tag" <<< "$behalten" || docker image rm "agentendorf-browser:$tag" >/dev/null 2>&1 || true
  done
}

# Erzwungener SSH-Befehl für den CI-Schlüssel: erlaubt nur "empfangen", "status", "hat-image <16 Hex>" und "hat-browser <16 Hex>".
cmd_ci() {
  local befehl=${SSH_ORIGINAL_COMMAND:-}
  case "$befehl" in
    empfangen) cmd_empfangen ;;
    status) cmd_status ;;
    "hat-image "*)
      local rv=${befehl#hat-image }
      [[ "$rv" =~ ^[a-f0-9]{16}$ ]] || { rot "Nicht erlaubt: $befehl"; exit 1; }
      if docker image inspect "agentendorf-rechenraum:$rv" >/dev/null 2>&1; then echo ja; else echo nein; fi ;;
    "hat-browser "*)
      local bv=${befehl#hat-browser }
      [[ "$bv" =~ ^[a-f0-9]{16}$ ]] || { rot "Nicht erlaubt: $befehl"; exit 1; }
      if docker image inspect "agentendorf-browser:$bv" >/dev/null 2>&1; then echo ja; else echo nein; fi ;;
    *) rot "Nicht erlaubt: $befehl"; exit 1 ;;
  esac
}

cmd_rollback() {
  local liste ziel
  liste=$(ls -1dt "$APP"/releases/*)
  ziel=$(echo "$liste" | grep -vx "$(readlink -f "$AKTUELL")" | head -1 || true)
  [ -n "$ziel" ] || { rot "Keine ältere Version vorhanden."; return 1; }
  ln -sfn "$ziel" "$AKTUELL.neu" && mv -T "$AKTUELL.neu" "$AKTUELL"
  cmd_deploy
}

cmd_status() {
  echo "Version: $(cat "$AKTUELL/VERSION" 2>/dev/null || echo –)"
  compose ps
  echo
  echo "Speicher:"; free -h | head -2
  echo "Platte:"; df -h "$BASIS" | tail -1
  echo "Last:"; uptime
  echo
  echo "Letzte Sicherungen:"; restic snapshots --compact 2>/dev/null | tail -9 || echo "  (noch keine)"
}

cmd_cli() { compose exec "$@"; }

cmd_backup() {
  mkdir -p "$BASIS/backup" "$BASIS/daten/sicherung"
  chown "$(stat -c %u "$BASIS/daten")" "$BASIS/daten/sicherung"
  restic cat config >/dev/null 2>&1 || restic init
  info "Sichere Datenbank konsistent …"
  compose exec -T dorf node dist/cli.js db-sichern /daten/sicherung/dorf.db
  info "Sichere Vault, Datenbank, Syncthing-Konfiguration, .env …"
  # DORF_BACKUP_ZEIT nur für Tests (simuliert ältere Tage)
  local ziele=("$BASIS/vault" "$BASIS/daten/sicherung" "$ENV_DATEI")
  local z
  for z in "$BASIS/syncthing/config" "$BASIS/werkstatt.env"; do [ -e "$z" ] && ziele+=("$z"); done
  restic backup --tag taeglich --host agentendorf ${DORF_BACKUP_ZEIT:+--time "$DORF_BACKUP_ZEIT"} \
    --exclude "$BASIS/syncthing/index-*" "${ziele[@]}"
  info "Behalte nur die Stände der letzten 7 Tage …"
  restic forget --tag taeglich --keep-within-daily "$BEHALTEN_TAGE" --prune
  restic check
  gruen "Sicherung fertig."
}

# Stellt den neuesten (oder angegebenen) Stand in einen Testordner wieder her und prüft ihn – ohne das Dorf anzufassen.
cmd_restore_test() {
  local snap=${1:-latest} ziel n_snap n_ziel unterschiede
  ziel=$(mktemp -d /tmp/dorf-wiederherstellungstest.XXXX)
  info "Stelle $snap nach $ziel wieder her …"
  restic restore "$snap" --target "$ziel"
  n_snap=$(restic ls "$snap" --json 2>/dev/null | grep -c '"type":"file"' || true)
  n_ziel=$(find "$ziel" -type f | wc -l)
  echo "Dateien im Stand: $n_snap, wiederhergestellt: $n_ziel"
  [ "$n_snap" -eq "$n_ziel" ] || { rot "Anzahl stimmt nicht!"; return 1; }
  if [ -f "$ziel$BASIS/daten/sicherung/dorf.db" ]; then
    echo -n "Datenbank: "; sqlite3 "$ziel$BASIS/daten/sicherung/dorf.db" "PRAGMA integrity_check;"
  fi
  unterschiede=$(diff -rq "$ziel$BASIS/vault" "$BASIS/vault" 2>/dev/null | wc -l || true)
  echo "Unterschiede zum aktuellen Vault (Änderungen seit der Sicherung): $unterschiede"
  restic check --read-data-subset=10%
  rm -rf "$ziel"
  gruen "Wiederherstellungstest bestanden."
}

# Echte Wiederherstellung des Vaults. Der aktuelle Stand wird vorher beiseitegelegt, nichts geht verloren.
cmd_wiederherstellen() {
  local snap=${1:-} zeit
  [ -n "$snap" ] || { echo "Aufruf: dorf wiederherstellen <snapshot-id|latest>"; restic snapshots --compact; return 1; }
  zeit=$(date +%Y%m%d-%H%M%S)
  read -r -p "Vault auf Stand $snap zurücksetzen? Aktueller Stand wird nach vault.vor-wiederherstellung-$zeit verschoben. [ja/nein] " a
  [ "$a" = ja ] || return 1
  compose stop dorf syncthing
  mv "$BASIS/vault" "$BASIS/vault.vor-wiederherstellung-$zeit"
  local tmp; tmp=$(mktemp -d)
  restic restore "$snap" --target "$tmp" --include "$BASIS/vault"
  mv "$tmp$BASIS/vault" "$BASIS/vault"
  rm -rf "$tmp"
  compose start dorf syncthing
  gesund_warten && gruen "Vault wiederhergestellt. Alter Stand liegt in $BASIS/vault.vor-wiederherstellung-$zeit"
}

# Abo-Anmeldung für den claude-code-Motor. Du meldest dich über Anthropics eigenen Ablauf an;
# das Token (1 Jahr gültig) landet nur in /srv/dorf/werkstatt.env – nie im Dorf, nie im Vault.
cmd_claude_anmelden() {
  geheimnisse_sicherstellen
  info "Starte 'claude setup-token' in der Werkstatt. Öffne den angezeigten Link, melde dich an und kopiere das Token."
  compose run --rm -it --no-deps --entrypoint claude werkstatt setup-token || true
  local token
  read -r -s -p "Token hier einfügen (Eingabe unsichtbar, leer = abbrechen): " token; echo
  token=$(printf '%s' "$token" | tr -d '\r\n ')
  [ -n "$token" ] || { rot "Abgebrochen."; return 1; }
  case "$token" in
    sk-ant-oat*) ;;
    *) rot "Das sieht nicht wie ein Abo-Token aus (es beginnt mit sk-ant-oat…)."; return 1 ;;
  esac
  case "$token" in *'/'*|*'|'*|*'&'*) rot "Ungültige Zeichen im Token."; return 1 ;; esac
  [ "${#token}" -ge 80 ] || { rot "Token zu kurz (${#token} Zeichen) – vermutlich beim Kopieren abgeschnitten (Zeilenumbruch?). Fenster breiter ziehen und neu versuchen."; return 1; }
  sed -i "s/^CLAUDE_CODE_OAUTH_TOKEN=.*/CLAUDE_CODE_OAUTH_TOKEN=$token/" "$BASIS/werkstatt.env"
  grep -q '^CLAUDE_CODE_OAUTH_TOKEN=' "$BASIS/werkstatt.env" || echo "CLAUDE_CODE_OAUTH_TOKEN=$token" >> "$BASIS/werkstatt.env"
  compose up -d --force-recreate werkstatt
  gruen "Abo-Token gespeichert, Werkstatt neu gestartet."
}

# API-Schlüssel für den api-Motor in /srv/dorf/.env eintragen (Eingabe unsichtbar).
cmd_api_schluessel() {
  local k
  read -r -s -p "Anthropic-API-Schlüssel (sk-ant-api…, Eingabe unsichtbar): " k; echo
  k=$(printf '%s' "$k" | tr -d '\r\n ')
  case "$k" in sk-ant-oat*) rot "Das ist ein Abo-Token, kein API-Schlüssel – dafür: dorf claude-anmelden"; return 1 ;; sk-ant-*) ;; *) rot "Das sieht nicht wie ein API-Schlüssel aus."; return 1 ;; esac
  case "$k" in *'/'*|*'|'*|*'&'*) rot "Ungültige Zeichen im Schlüssel."; return 1 ;; esac
  [ "${#k}" -ge 80 ] || { rot "Schlüssel zu kurz (${#k} Zeichen) – vermutlich abgeschnitten."; return 1; }
  sed -i '/^#\? *ANTHROPIC_API_KEY=/d' "$ENV_DATEI"
  echo "ANTHROPIC_API_KEY=$k" >> "$ENV_DATEI"
  compose up -d --force-recreate dorf
  gruen "API-Schlüssel gespeichert, Dorf neu gestartet."
}

# Telegram-Bot koppeln: Token prüfen, dein /start abwarten, Chat-ID bestätigen, eintragen.
cmd_telegram_einrichten() {
  local t name upd chat id antwort letzte
  read -r -s -p "Bot-Token von @BotFather (Eingabe unsichtbar): " t; echo
  t=$(printf '%s' "$t" | tr -d '\r\n ')
  [[ "$t" =~ ^[0-9]+:[A-Za-z0-9_-]{30,}$ ]] || { rot "Das sieht nicht wie ein Bot-Token aus (Zahl:Buchstaben…)."; return 1; }
  name=$(curl -fsS "https://api.telegram.org/bot$t/getMe" | jq -r '.result.username // empty') || true
  [ -n "$name" ] || { rot "Telegram kennt dieses Token nicht."; return 1; }
  gruen "Bot @$name gefunden."
  # Solange wir koppeln, darf das Dorf nicht gleichzeitig abfragen.
  sed -i '/^TELEGRAM_BOT_TOKEN=/d;/^TELEGRAM_CHAT_ID=/d' "$ENV_DATEI"
  compose up -d --force-recreate dorf >/dev/null 2>&1 || true
  curl -fsS "https://api.telegram.org/bot$t/deleteWebhook" >/dev/null || true
  info "Öffne Telegram, suche @$name und schicke ihm /start. Ich warte bis zu 2 Minuten …"
  chat=""
  for _ in $(seq 1 24); do
    upd=$(curl -fsS "https://api.telegram.org/bot$t/getUpdates?timeout=5") || upd='{"result":[]}'
    chat=$(jq -r '[.result[] | select(.message.text != null and (.message.text | startswith("/start"))) | .message.chat] | last // empty | "\(.id)|\(.first_name // "")|\(.username // "")"' <<<"$upd")
    [ -n "$chat" ] && break
  done
  [ -n "$chat" ] || { rot "Kein /start angekommen. Bitte nochmal: dorf telegram-einrichten"; return 1; }
  id=${chat%%|*}
  read -r -p "Gefunden: $(cut -d'|' -f2 <<<"$chat") (@$(cut -d'|' -f3 <<<"$chat"), Chat-ID $id). Ist das dein Konto? [ja/nein] " antwort
  [ "$antwort" = ja ] || { rot "Abgebrochen."; return 1; }
  # Bisherige Nachrichten als gelesen markieren, damit /start nicht als Aufgabe ankommt
  letzte=$(jq '[.result[].update_id] | max // 0' <<<"$upd")
  curl -fsS "https://api.telegram.org/bot$t/getUpdates?offset=$((letzte + 1))&timeout=0" >/dev/null || true
  printf 'TELEGRAM_BOT_TOKEN=%s\nTELEGRAM_CHAT_ID=%s\n' "$t" "$id" >> "$ENV_DATEI"
  compose up -d --force-recreate dorf
  gruen "Telegram eingerichtet. Schick dem Bot eine Aufgabe – oder in der App: Rathaus → Agenten-Einstellungen → Testnachricht."
}

# Moodle verbinden wie die offizielle Moodle-App: Anmeldung im Browser (JKU-SSO), Token aus der moodlemobile://-Adresse.
cmd_moodle_anmelden() {
  local url passport adresse token
  url=${1:-$(sed -n 's/^MOODLE_URL=//p' "$ENV_DATEI" | tail -1)}
  url=${url:-https://moodle.jku.at}
  url=${url%/}
  [[ "$url" =~ ^https://[A-Za-z0-9.-]+(/[A-Za-z0-9._/-]*)?$ ]] || { rot "Ungültige Moodle-Adresse: $url"; return 1; }
  passport=$(head -c 16 /dev/urandom | od -An -tu4 | tr -dc 0-9 | cut -c1-12)
  info "1. Öffne am PC diese Adresse und melde dich mit deinem JKU-Konto an:"
  echo
  echo "   $url/admin/tool/mobile/launch.php?service=moodle_mobile_app&passport=$passport&urlscheme=moodlemobile"
  echo
  info "2. Am Ende will Moodle eine Adresse 'moodlemobile://token=…' öffnen. Kopiere sie vollständig:"
  info "   Firefox: steht in der Fehlermeldung bzw. Adresszeile.  Chrome/Edge: vorher F12 → Netzwerk → 'Log beibehalten',"
  info "   dann den Eintrag launch.php anklicken → Antwort-Header 'Location'."
  read -r -s -p "3. Adresse hier einfügen (Eingabe unsichtbar, leer = abbrechen): " adresse; echo
  adresse=$(printf '%s' "$adresse" | tr -d '\r\n ')
  [ -n "$adresse" ] || { rot "Abgebrochen."; return 1; }
  if ! token=$(printf '%s' "$adresse" | compose exec -T dorf node dist/cli.js moodle-token "$url" "$passport"); then
    rot "Nicht gespeichert (siehe Meldung oben)."; return 1
  fi
  [[ "$token" =~ ^[A-Za-z0-9]{16,64}$ ]] || { rot "Unerwartete Antwort – nicht gespeichert."; return 1; }
  sed -i '/^MOODLE_URL=/d;/^MOODLE_TOKEN=/d' "$ENV_DATEI"
  printf 'MOODLE_URL=%s\nMOODLE_TOKEN=%s\n' "$url" "$token" >> "$ENV_DATEI"
  compose up -d --force-recreate dorf
  gruen "Moodle verbunden. Der erste Abgleich startet in einer Minute (Uni → Übersicht → 'Jetzt abgleichen' geht sofort)."
}

# Moodle-Browser: JKU-Zugangsdaten nur in browser.env (liest nur der Browser-Container), dann Anmeldung prüfen.
cmd_moodle_browser_zugang() {
  local benutzer passwort hosts neu uid datei="$BASIS/browser.env"
  [ -f "$AKTUELL/BROWSER_VERSION" ] || { rot "Diese Version hat noch keinen Moodle-Browser – nach dem nächsten Deploy erneut versuchen."; return 1; }
  geheimnisse_sicherstellen
  info "Dein JKU-Login (wie bei moodle.jku.at). Wird nur auf diesem Server in $datei gespeichert."
  read -r -p "Benutzername (z. B. k12345678): " benutzer
  benutzer=$(printf '%s' "$benutzer" | tr -d '\r\n ')
  [[ "$benutzer" =~ ^[A-Za-z0-9._@-]{2,80}$ ]] || { rot "Ungültiger Benutzername."; return 1; }
  IFS= read -r -s -p "Passwort (unsichtbar): " passwort; echo
  [ -n "$passwort" ] || { rot "Abgebrochen."; return 1; }
  case "$passwort" in *$'\n'*|*$'\r'*) rot "Passwort mit Zeilenumbruch geht nicht."; return 1 ;; esac
  hosts=$(sed -n 's/^BROWSER_HOSTS=//p' "$datei" | tail -1)
  read -r -p "Erlaubte Domains [${hosts:-jku.at}] (Enter = so lassen): " neu
  neu=$(printf '%s' "${neu:-}" | tr -d '\r ')
  [ -z "$neu" ] || hosts=$neu
  [[ "${hosts:-jku.at}" =~ ^[a-z0-9.,-]+$ ]] || { rot "Ungültige Domains (nur z. B. jku.at,login.example.org)."; return 1; }
  # Zeilen ersetzen, ohne das Passwort durch sed zu schicken
  grep -vE '^(MOODLE_BENUTZER|MOODLE_PASSWORT|BROWSER_HOSTS)=' "$datei" > "$datei.neu" || true
  { printf 'MOODLE_BENUTZER=%s\n' "$benutzer"; printf 'MOODLE_PASSWORT=%s\n' "$passwort"; printf 'BROWSER_HOSTS=%s\n' "${hosts:-jku.at}"; } >> "$datei.neu"
  chmod 600 "$datei.neu" && mv "$datei.neu" "$datei"
  uid=$(grep -E '^DORF_UID=' "$ENV_DATEI" | cut -d= -f2 || true)
  chown "${uid:-1000}:${uid:-1000}" "$datei" 2>/dev/null || true
  compose up -d --force-recreate browser dorf
  info "Prüfe die Anmeldung bei Moodle (bis zu einer Minute) …"
  sleep 5
  if compose exec -T browser node runner.js pruefen; then
    gruen "Moodle-Browser angemeldet. In der App: Uni → Aktionen → Moodle durchsehen."
  else
    rot "Anmeldung hat nicht geklappt (Meldung oben). Daten prüfen und 'dorf moodle-browser-zugang' erneut ausführen."
    return 1
  fi
}

# Gmail anmelden (OAuth, nur Lesen + Entwürfe). Client-ID/-Schlüssel aus Leifs eigenem Google-Cloud-Projekt.
cmd_gmail_anmelden() {
  local id secret aus adresse verifier state rueck token
  info "Google Cloud Console → Clients → deine Desktop-App: Client-ID und Clientschlüssel bereithalten."
  read -r -p "Client-ID: " id
  id=$(printf '%s' "$id" | tr -d '\r\n ')
  [[ "$id" =~ ^[0-9]+-[a-z0-9]+\.apps\.googleusercontent\.com$ ]] || { rot "Das sieht nicht wie eine Client-ID aus (…apps.googleusercontent.com)."; return 1; }
  read -r -s -p "Clientschlüssel (unsichtbar): " secret; echo
  secret=$(printf '%s' "$secret" | tr -d '\r\n ')
  [[ "$secret" =~ ^[A-Za-z0-9_-]{10,100}$ ]] || { rot "Das sieht nicht wie ein Clientschlüssel aus."; return 1; }
  aus=$(compose exec -T dorf node dist/cli.js gmail-anmelden-start "$id") || { rot "Konnte die Anmeldung nicht vorbereiten."; return 1; }
  adresse=$(sed -n 1p <<<"$aus"); verifier=$(sed -n 2p <<<"$aus"); state=$(sed -n 3p <<<"$aus")
  info "1. Öffne diese Adresse im Browser und melde dich mit deinem Gmail-Konto an:"
  echo; echo "   $adresse"; echo
  info "2. Warnt Google, die App sei nicht überprüft: Erweitert → Weiter zu Agentendorf. Beide Zugriffe erlauben."
  info "3. Danach lädt eine Seite, die nicht erreichbar ist (127.0.0.1) – das ist richtig so."
  info "   Kopiere die KOMPLETTE Adresse aus der Adresszeile (beginnt mit http://127.0.0.1:8765/)."
  read -r -s -p "4. Adresse hier einfügen (unsichtbar): " rueck; echo
  rueck=$(printf '%s' "$rueck" | tr -d '\r\n ')
  [ -n "$rueck" ] || { rot "Abgebrochen."; return 1; }
  if ! token=$(jq -n --arg c "$id" --arg s "$secret" --arg v "$verifier" --arg st "$state" --arg a "$rueck" \
      '{clientId:$c, clientSecret:$s, verifier:$v, state:$st, adresse:$a}' | compose exec -T dorf node dist/cli.js gmail-anmelden-tauschen); then
    rot "Nicht gespeichert (siehe Meldung oben)."; return 1
  fi
  [[ "$token" =~ ^[A-Za-z0-9_./-]{20,512}$ ]] || { rot "Unerwartete Antwort – nicht gespeichert."; return 1; }
  sed -i '/^GMAIL_CLIENT_ID=/d;/^GMAIL_CLIENT_SECRET=/d;/^GMAIL_REFRESH_TOKEN=/d' "$ENV_DATEI"
  printf 'GMAIL_CLIENT_ID=%s\nGMAIL_CLIENT_SECRET=%s\nGMAIL_REFRESH_TOKEN=%s\n' "$id" "$secret" "$token" >> "$ENV_DATEI"
  compose up -d --force-recreate dorf
  gruen "Gmail verbunden. In der App: Post → Eingang → Jetzt abholen (sonst automatisch alle 10 Minuten)."
}

# Google-Kalender (geheime iCal-Adressen): „Moodle-Fristen (automatisch)“ aus Leifs Skript, „JKU Pflicht“
# und der Hauptkalender (nur für die Morgenzeitung, wird nicht gespeichert).
cmd_google_kalender() {
  local art url var geaendert=""
  info "Google Kalender (Browser) → Zahnrad → Einstellungen → links den Kalender wählen → Kalender integrieren"
  info "→ Geheime Adresse im iCal-Format kopieren. Leer lassen + Enter = diesen Kalender nicht ändern."
  for art in fristen pflicht termine; do
    case "$art" in
      fristen) var=GOOGLE_FRISTEN_ICS; read -r -s -p "Adresse von Moodle-Fristen (automatisch) (unsichtbar): " url; echo ;;
      pflicht) var=GOOGLE_PFLICHT_ICS; read -r -s -p "Adresse von JKU Pflicht (unsichtbar): " url; echo ;;
      termine) var=GOOGLE_TERMINE_ICS; read -r -s -p "Adresse deines Hauptkalenders, fuer die Morgenzeitung (unsichtbar): " url; echo ;;
    esac
    url=$(printf '%s' "$url" | tr -d '\r\n ')
    if [ -z "$url" ]; then info "übersprungen"; continue; fi
    [[ "$url" =~ ^https://calendar\.google\.com/calendar/ical/[A-Za-z0-9%._@+-]+/private-[0-9a-f]{16,64}/basic\.ics$ ]] \
      || { rot "Das ist keine geheime Google-Kalender-Adresse (…/calendar/ical/…/private-…/basic.ics)."; return 1; }
    if ! printf '%s' "$url" | compose exec -T dorf node dist/cli.js google-kalender-pruefen "$art"; then
      rot "Nicht gespeichert (siehe Meldung oben)."; return 1
    fi
    sed -i "/^$var=/d" "$ENV_DATEI"
    printf '%s=%s\n' "$var" "$url" >> "$ENV_DATEI"
    geaendert=ja
  done
  [ -n "$geaendert" ] || { info "Nichts geändert."; return 0; }
  # Fristen kommen jetzt über dein Skript aus Google – der direkte Moodle-Kalender würde sie doppelt liefern
  if grep -q '^GOOGLE_FRISTEN_ICS=' "$ENV_DATEI" && grep -q '^MOODLE_KALENDER_URL=' "$ENV_DATEI"; then
    sed -i '/^MOODLE_KALENDER_URL=/d' "$ENV_DATEI"
    info "Direkter Moodle-Kalender entfernt (dein Skript trägt die Fristen schon in Google ein)."
  fi
  compose up -d --force-recreate dorf
  gruen "Google-Kalender eingetragen. In der App: Uni → Studium → Jetzt abgleichen (sonst automatisch alle 3 Stunden)."
}

# Fristen über den Kalender-Export von Moodle (an der JKU der Weg, weil der App-Zugang gesperrt ist).
cmd_moodle_kalender() {
  local url
  info "In Moodle: Kalender → Exportieren → Alle Termine + längster Zeitraum → Kalender-URL abrufen → Adresse kopieren."
  read -r -s -p "Kalender-Adresse hier einfügen (Eingabe unsichtbar, leer = abbrechen): " url; echo
  url=$(printf '%s' "$url" | tr -d '\r\n ')
  [ -n "$url" ] || { rot "Abgebrochen."; return 1; }
  [[ "$url" =~ ^https://[A-Za-z0-9.-]+(/[A-Za-z0-9._-]+)*/calendar/export_execute\.php\?[A-Za-z0-9_=\&%.+-]+$ ]] \
    || { rot "Das sieht nicht wie eine Moodle-Kalender-Adresse aus (…/calendar/export_execute.php?…)."; return 1; }
  [[ "$url" == *authtoken=* ]] || { rot "In der Adresse fehlt authtoken= – bitte die vollständige Adresse kopieren."; return 1; }
  if ! printf '%s' "$url" | compose exec -T dorf node dist/cli.js moodle-kalender-pruefen; then
    rot "Nicht gespeichert (siehe Meldung oben)."; return 1
  fi
  sed -i '/^MOODLE_KALENDER_URL=/d' "$ENV_DATEI"
  printf 'MOODLE_KALENDER_URL=%s\n' "$url" >> "$ENV_DATEI"
  compose up -d --force-recreate dorf
  gruen "Kalender verbunden. In der App: Uni → Studium → Jetzt abgleichen (sonst automatisch alle 3 Stunden)."
}

cmd_syncthing_id() { compose exec -T syncthing syncthing device-id 2>/dev/null || compose exec -T syncthing syncthing --device-id; }

cmd_syncthing_geraet() {
  local id=${1:-} name=${2:-}
  [ -n "$id" ] && [ -n "$name" ] || { echo "Aufruf: dorf syncthing-geraet <GERAETE-ID> <Name>"; return 1; }
  local st=(compose exec -T syncthing syncthing cli)
  "${st[@]}" config folders list 2>/dev/null | grep -qx vault || "${st[@]}" config folders add --id vault --label Agentendorf --path /var/syncthing/vault
  "${st[@]}" config devices add --device-id "$id" --name "$name"
  "${st[@]}" config folders vault devices add --device-id "$id"
  gruen "Gerät $name hinzugefügt. Auf dem Gerät: Server-ID ($(cmd_syncthing_id)) hinzufügen und den Ordner 'Agentendorf' annehmen."
}

