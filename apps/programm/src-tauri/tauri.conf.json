{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentendorf",
  "version": "0.1.0",
  "identifier": "app.agentendorf.dorf",
  "build": { "frontendDist": "../einrichten" },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Dein Agentendorf in einem eigenen Fenster",
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "12.0" },
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["German"] } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGRDcxMUYyMTAzRkJEMEYKUldRUHZUOFE4aEhYMzRGNnBMYnd1M2Q4ZHJkK2x6UnFxOEJRbmdmekplQ1Z0QUNVd1h6MFoxQXEK",
      "endpoints": [],
      "windows": { "installMode": "passive" }
    }
  }
}
